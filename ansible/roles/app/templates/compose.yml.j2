# Gerado pelo Ansible a partir do compose.yaml do repositório — não edite na VM.
#
# Diferenças em relação ao compose local:
#   - sem o serviço "db": a API usa a VM exclusiva pelo IP privado ({{ hostvars['db'].private_ip }});
#   - "build:" trocado pelas imagens do GHCR com a tag da pipeline ({{ docker_tag }});
#   - gateway publica 80/443 com HTTPS; SMART_API_ENVIRONMENT=production (cookies Secure);
#   - origem permitida = https://{{ domain }};
#   - jobs de preparação no profile "jobs": o Ansible os executa uma vez, na ordem certa,
#     para que reexecuções da pipeline não reiniciem nada sem necessidade.
name: smart-construction

x-hardening: &hardening
  read_only: true
  tmpfs:
    - /tmp
  cap_drop: ['ALL']
  security_opt: ['no-new-privileges:true']
  logging:
    driver: local

services:
  gateway:
    image: nginx:1.28-alpine
    ports:
      - '80:80'
      - '443:443'
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    depends_on:
      web:
        condition: service_healthy
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1/healthz']
      interval: 10s
      timeout: 3s
      retries: 12
    restart: unless-stopped

  web:
    image: {{ registry }}/smart-web:{{ docker_tag }}
    environment:
      API_INTERNAL_URL: http://api:8000
      REGISTRATIONS_UI_ENABLED: 'true'
    depends_on:
      api:
        condition: service_healthy
      storage:
        condition: service_healthy
    init: true
    restart: unless-stopped

  api:
    <<: *hardening
    image: {{ registry }}/smart-api:{{ docker_tag }}
    environment:
      SMART_API_ENVIRONMENT: production
      SMART_API_ALLOWED_ORIGINS: '["https://{{ domain }}"]'
      SMART_API_DB_HOST: {{ hostvars['db'].private_ip }}
      SMART_API_DB_USER: {{ postgres_runtime_user }}
      SMART_API_DB_PASSWORD_FILE: /run/secrets/runtime_password
      SMART_API_REGISTRATIONS_ENABLED: 'true'
      SMART_API_TERMS_VERSION: {{ terms_version }}
      SMART_API_PRIVACY_VERSION: {{ privacy_version }}
      SMART_API_S3_ENDPOINT_URL: http://private-storage:8333
      SMART_API_S3_ACCESS_KEY_FILE: /run/secrets/private_api_access
      SMART_API_S3_SECRET_KEY_FILE: /run/secrets/private_api_secret
    secrets:
      - runtime_password
      - private_api_access
      - private_api_secret
    depends_on:
      private-storage:
        condition: service_healthy
    init: true
    restart: unless-stopped

  private-storage:
    image: chrislusf/seaweedfs:4.48
    entrypoint: ['/bin/sh', '/opt/backend-storage/private-storage.sh']
    volumes:
      - private-storage-data:/data
      - ./backend-storage:/opt/backend-storage:ro
    secrets:
      - private_identities
      - private_admin_password
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:9333/cluster/status']
      interval: 5s
      timeout: 3s
      retries: 24
      start_period: 15s
    restart: unless-stopped
    init: true
    logging:
      driver: local

  storage:
    image: chrislusf/seaweedfs:4.48
    entrypoint: ['/bin/sh', '/opt/storage/start.sh']
    environment:
      S3_BUCKET: {{ assets_bucket }}
    volumes:
      - storage-data:/data
      - ./storage:/opt/storage:ro
    secrets:
      - storage_access_key
      - storage_secret_key
      - storage_admin_password
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:9333/cluster/status']
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    init: true
    restart: unless-stopped

  # ------------------------------------------------ jobs (executados pelo Ansible)
  api-migrate:
    <<: *hardening
    profiles: ['jobs']
    image: {{ registry }}/smart-api:{{ docker_tag }}
    command: ['alembic', 'upgrade', 'head']
    environment:
      SMART_API_DB_HOST: {{ hostvars['db'].private_ip }}
      SMART_API_DB_USER: {{ postgres_migrator }}
      SMART_API_DB_PASSWORD_FILE: /run/secrets/migration_password
    secrets:
      - migration_password
    restart: 'no'

  private-storage-init:
    <<: *hardening
    profiles: ['jobs']
    image: {{ registry }}/smart-api:{{ docker_tag }}
    command: ['python', '-m', 'app.arquivos.bootstrap']
    environment:
      SMART_API_S3_ENDPOINT_URL: http://private-storage:8333
      SMART_API_S3_ACCESS_KEY_FILE: /run/secrets/private_bootstrap_access
      SMART_API_S3_SECRET_KEY_FILE: /run/secrets/private_bootstrap_secret
    secrets:
      - private_bootstrap_access
      - private_bootstrap_secret
    depends_on:
      private-storage:
        condition: service_healthy
    restart: 'no'

  storage-init:
    profiles: ['jobs']
    image: amazon/aws-cli:2.38.3
    entrypoint: ['/bin/sh', '/opt/storage/init.sh']
    environment:
      S3_BUCKET: {{ assets_bucket }}
      AWS_DEFAULT_REGION: us-east-1
      AWS_EC2_METADATA_DISABLED: 'true'
      AWS_PAGER: ''
    volumes:
      - ./storage:/opt/storage:ro
      - ./seed:/seed:ro
    secrets:
      - storage_access_key
      - storage_secret_key
    depends_on:
      storage:
        condition: service_healthy
    restart: 'no'

volumes:
  private-storage-data:
  storage-data:

secrets:
  runtime_password:
    file: ./.secrets/backend/api-password
  migration_password:
    file: ./.secrets/backend/migration-password
  private_identities:
    file: ./.secrets/backend/s3-identities.json
  private_admin_password:
    file: ./.secrets/backend/s3-admin-password
  private_api_access:
    file: ./.secrets/backend/s3-api-access-key
  private_api_secret:
    file: ./.secrets/backend/s3-api-secret-key
  private_bootstrap_access:
    file: ./.secrets/backend/s3-bootstrap-access-key
  private_bootstrap_secret:
    file: ./.secrets/backend/s3-bootstrap-secret-key
  storage_access_key:
    file: ./.secrets/storage/access-key
  storage_secret_key:
    file: ./.secrets/storage/secret-key
  storage_admin_password:
    file: ./.secrets/storage/admin-password
